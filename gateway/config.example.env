# Synthetic example; token file must contain a newly generated private token.
HELIVOICE_BIND=127.0.0.1
HELIVOICE_PORT=11990
HELIVOICE_WYOMING_URI=tcp://127.0.0.1:10300
HELIVOICE_LANGUAGE=fr
HELIVOICE_TOKEN_FILE=/run/secrets/helivoice-token
HELIVOICE_MAX_AUDIO_BYTES=41943040
HELIVOICE_MAX_DURATION_SECONDS=1200
HELIVOICE_TRANSCRIBE_TIMEOUT_SECONDS=1800
